+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+/**
+ * @fileoverview A helper object used from the "Scope services" section
+ * to request a changelog (if one exists).
+ */
+
+// clang-format off
+import {sendWithPromise} from 'chrome://resources/js/cr.js';
+// clang-format on
+
+export interface ScopeServicesChangeHandler {
+  // Get the pending changes to Scope services to announce
+  // to the user.
+  requestChangelog(): Promise<string[]>;
+  acknowledgeChanges(ignoreAllChangelogs: boolean): void;
+}
+
+export class ScopeServicesChangeHandlerImpl implements
+    ScopeServicesChangeHandler {
+  requestChangelog() {
+    return sendWithPromise<string[]>('getServicesSchemaChangelog');
+  }
+
+  acknowledgeChanges(ignoreAllChangelogs: boolean) {
+    chrome.send('updateServicesSchemaVersion', [ignoreAllChangelogs]);
+  }
+
+  static getInstance(): ScopeServicesChangeHandler {
+    return instance || (instance = new ScopeServicesChangeHandlerImpl());
+  }
+
+  static setInstance(obj: ScopeServicesChangeHandler) {
+    instance = obj;
+  }
+}
+
+let instance: ScopeServicesChangeHandler|null = null;
