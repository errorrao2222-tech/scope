+// Copyright 2025 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "components/scope_services/scope_services_helpers.h"
+
+#include <optional>
+
+#include "base/functional/bind.h"
+#include "components/scope_services/pref_names.h"
+#include "components/prefs/pref_service.h"
+#include "net/base/url_util.h"
+#include "url/gurl.h"
+#include "url/url_constants.h"
+
+namespace scope {
+
+std::optional<GURL> GetValidUserOverridenURL(std::string_view user_url_) {
+    if (user_url_.empty()) {
+        return std::nullopt;
+    }
+
+    GURL user_url = GURL(user_url_);
+    if (!user_url.is_valid()) {
+        return std::nullopt;
+    }
+
+    bool isSecure = user_url.SchemeIs(url::kHttpsScheme) || net::IsLocalhost(user_url);
+    if (!isSecure) {
+        return std::nullopt;
+    }
+
+    return user_url;
+}
+
+std::optional<GURL> GetValidUserOverridenURL(const PrefService& prefs) {
+    return GetValidUserOverridenURL(
+        prefs.GetString(prefs::kScopeServicesOrigin)
+    );
+}
+
+GURL GetServicesBaseURL(const PrefService& prefs) {
+    std::optional<GURL> user_url = GetValidUserOverridenURL(prefs);
+    if (user_url) {
+        return *user_url;
+    }
+
+    return GURL(kScopeDefaultOrigin);
+}
+
+GURL GetDummyURL() {
+    return GURL(kScopeDummyOrigin);
+}
+
+bool ShouldAccessServices(const PrefService& prefs) {
+    return prefs.GetBoolean(prefs::kScopeServicesEnabled);
+}
+
+void ConfigurePrefChangeRegistrarFor(std::string_view pref_name,
+    PrefChangeRegistrar& registrar, const base::RepeatingClosure& observer) {
+  registrar.Add(prefs::kScopeServicesEnabled, observer);
+  registrar.Add(prefs::kScopeServicesOrigin, observer);
+  registrar.Add(prefs::kScopeSchemaVersion, observer);
+  registrar.Add(pref_name, observer);
+}
+
+}  // namespace scope
