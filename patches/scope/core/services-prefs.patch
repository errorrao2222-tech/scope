+// Copyright 2025 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/webui/settings/services_schema_handler.h"
+
+#include "base/functional/bind.h"
+#include "base/values.h"
+#include "chrome/browser/profiles/profile.h"
+#include "components/scope_services/pref_names.h"
+#include "components/scope_services/schema.h"
+#include "components/prefs/pref_service.h"
+
+ScopeServicesSchemaHandler::ScopeServicesSchemaHandler(Profile* profile)
+    : pref_service_(profile->GetPrefs()) {}
+
+ScopeServicesSchemaHandler::~ScopeServicesSchemaHandler() = default;
+
+void ScopeServicesSchemaHandler::RegisterMessages() {
+  web_ui()->RegisterMessageCallback(
+      "getServicesSchemaChangelog",
+      base::BindRepeating(&ScopeServicesSchemaHandler::HandleChangelogRequest,
+                          base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "updateServicesSchemaVersion",
+      base::BindRepeating(
+          &ScopeServicesSchemaHandler::HandleChangelogAcknowledgment,
+          base::Unretained(this)));
+}
+
+void ScopeServicesSchemaHandler::HandleChangelogRequest(
+    const base::ListValue& args) {
+  CHECK_EQ(1U, args.size());
+  const auto& callback_id = args[0].GetString();
+  base::ListValue out;
+
+  if (scope::ShouldShowSchemaNotification(*pref_service_)) {
+    int user_version = pref_service_->GetInteger(prefs::kScopeSchemaVersion);
+    auto& changelog = scope::GetChangelog();
+
+    for (auto it = changelog.upper_bound(user_version); it != changelog.end();
+         ++it) {
+      out.Append(it->second);
+    }
+  }
+
+  AllowJavascript();
+  ResolveJavascriptCallback(base::Value(callback_id), std::move(out));
+}
+
+void ScopeServicesSchemaHandler::HandleChangelogAcknowledgment(
+    const base::ListValue& args) {
+  CHECK_EQ(1U, args.size());
+  bool ignore_alerts = args[0].GetBool();
+
+  scope::AcceptCurrentSchema(*pref_service_);
+  pref_service_->SetBoolean(prefs::kScopeDisableSchemaAlerts, ignore_alerts);
+}
