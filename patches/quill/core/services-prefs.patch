+// Copyright 2025 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+/**
+ * @fileoverview A helper object used from the "Quill services" section
+ * to request a changelog (if one exists).
+ */
+
+// clang-format off
+import {sendWithPromise} from 'chrome://resources/js/cr.js';
+// clang-format on
+
+export interface QuillServicesChangeHandler {
+  // Get the pending changes to Quill services to announce
+  // to the user.
+  requestChangelog(): Promise<string[]>;
+  acknowledgeChanges(ignoreAllChangelogs: boolean): void;
+}
+
+export class QuillServicesChangeHandlerImpl implements
+    QuillServicesChangeHandler {
+  requestChangelog() {
+    return sendWithPromise<string[]>('getServicesSchemaChangelog');
+  }
+
+  acknowledgeChanges(ignoreAllChangelogs: boolean) {
+    chrome.send('updateServicesSchemaVersion', [ignoreAllChangelogs]);
+  }
+
+  static getInstance(): QuillServicesChangeHandler {
+    return instance || (instance = new QuillServicesChangeHandlerImpl());
+  }
+
+  static setInstance(obj: QuillServicesChangeHandler) {
+    instance = obj;
+  }
+}
+
+let instance: QuillServicesChangeHandler|null = null;
